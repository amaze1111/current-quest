# Copy to .env for local development. Never commit the real .env file.

# Server
PORT=3000
NODE_ENV=development

# Postgres connection string. This can point at a database instance shared with other
# apps — all tables live under the current_quest schema (see migrations/001_init.sql),
# not the shared instance's public schema, so no table names collide.
# e.g. postgres://user:pass@host:5432/shared_db_name
DATABASE_URL=
# Set to true when connecting to a managed Postgres that terminates TLS with a
# self-signed/short chain (Render, Railway, etc.). Leave false for local Postgres.
DATABASE_SSL=false

# Comma-separated list of allowed CORS origins, or * to allow all (fine for a public
# read-only API; tighten this once there's a web dashboard with a known origin).
CORS_ORIGINS=*

# Full Firebase service-account JSON (Project Settings > Service Accounts > Generate key),
# base64-encoded onto a single line: base64 -w0 service-account.json
# Verifies player ID tokens sent by the Android app; the Firebase project id is read out of
# this JSON itself, so there's no separate FIREBASE_PROJECT_ID var.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Google Play Developer API — used to verify star-pack purchase tokens server-side.
# Service account JSON (Play Console > Setup > API access), base64-encoded onto one line.
# This account needs "View financial data" + order management permission for the app.
# (The Android package name is hardcoded in src/config.ts — it's this app's fixed
# applicationId, not per-environment config.)
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=

# Dev-only bypass: `Authorization: Dev <uid>` skips Firebase verification for curl testing.
# Config validation throws at boot if this is true while NODE_ENV=production.
ALLOW_DEV_AUTH=false
